{
  "format": "custom",
  "id": "site_settings",
  "label": "Site settings",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "site_title": {
        "type": "Text",
        "config": {
          "label": "Site title"
        }
      },
      "tagline": {
        "type": "Text",
        "config": {
          "label": "Tagline"
        }
      },
      "about": {
        "type": "StructuredText",
        "config": {
          "label": "About",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "featured_shelf": {
        "type": "Link",
        "config": {
          "label": "Featured shelf",
          "select": "document",
          "customtypes": [
            "shelf"
          ]
        }
      }
    },
    "SEO": {
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
