{
  "format": "page",
  "id": "book",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Title"
        },
        "type": "Text"
      },
      "subtitle": {
        "config": {
          "label": "Subtitle"
        },
        "type": "Text"
      },
      "authors": {
        "config": {
          "fields": {
            "author": {
              "config": {
                "customtypes": [
                  "author"
                ],
                "label": "Author",
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Authors"
        },
        "type": "Group"
      },
      "contributors": {
        "config": {
          "fields": {
            "name": {
              "config": {
                "label": "Name"
              },
              "type": "Text"
            },
            "role": {
              "config": {
                "label": "Role",
                "options": [
                  "narrator",
                  "translator",
                  "editor",
                  "illustrator",
                  "other"
                ]
              },
              "type": "Select"
            }
          },
          "label": "Contributors"
        },
        "type": "Group"
      },
      "series": {
        "config": {
          "customtypes": [
            "series"
          ],
          "label": "Series",
          "select": "document"
        },
        "type": "Link"
      },
      "series_position": {
        "config": {
          "label": "Series position",
          "min": 0
        },
        "type": "Number"
      },
      "genres": {
        "config": {
          "fields": {
            "genre": {
              "config": {
                "customtypes": [
                  "genre"
                ],
                "label": "Genre",
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Genres"
        },
        "type": "Group"
      },
      "cover": {
        "config": {
          "constraint": {},
          "label": "Cover",
          "thumbnails": []
        },
        "type": "Image"
      },
      "isbn": {
        "config": {
          "label": "ISBN / StoryGraph UID",
          "placeholder": "ISBN-13, ISBN-10, ASIN or empty"
        },
        "type": "Text"
      },
      "publish_year": {
        "config": {
          "label": "Publish year",
          "max": 2100,
          "min": 0,
          "step": 1
        },
        "type": "Number"
      },
      "page_count": {
        "config": {
          "label": "Page count",
          "min": 1,
          "step": 1
        },
        "type": "Number"
      },
      "format": {
        "config": {
          "label": "Format",
          "options": [
            "paperback",
            "hardcover",
            "digital",
            "audio"
          ]
        },
        "type": "Select"
      },
      "owned": {
        "config": {
          "default_value": false,
          "label": "Owned"
        },
        "type": "Boolean"
      },
      "blurb": {
        "config": {
          "label": "Description / blurb",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        },
        "type": "StructuredText"
      }
    },
    "Reading": {
      "read_status": {
        "config": {
          "label": "Read status",
          "options": [
            "to-read",
            "currently-reading",
            "read",
            "did-not-finish",
            "paused"
          ]
        },
        "type": "Select"
      },
      "date_added": {
        "config": {
          "label": "Date added"
        },
        "type": "Date"
      },
      "last_date_read": {
        "config": {
          "label": "Last date read"
        },
        "type": "Date"
      },
      "year_read": {
        "config": {
          "label": "Year read",
          "max": 2100,
          "min": 1900,
          "step": 1
        },
        "type": "Number"
      },
      "read_count": {
        "config": {
          "label": "Read count",
          "min": 0,
          "step": 1
        },
        "type": "Number"
      },
      "dates_read": {
        "config": {
          "fields": {
            "date_started": {
              "config": {
                "label": "Started"
              },
              "type": "Date"
            },
            "date_finished": {
              "config": {
                "label": "Finished"
              },
              "type": "Date"
            }
          },
          "label": "Dates read"
        },
        "type": "Group"
      },
      "rating": {
        "config": {
          "label": "Star rating",
          "max": 5,
          "min": 0,
          "step": 0.25
        },
        "type": "Number"
      },
      "review": {
        "config": {
          "label": "Review (private, not displayed in v1)",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        },
        "type": "StructuredText"
      }
    },
    "StoryGraph": {
      "moods": {
        "config": {
          "fields": {
            "mood": {
              "config": {
                "label": "Mood"
              },
              "type": "Text"
            }
          },
          "label": "Moods"
        },
        "type": "Group"
      },
      "pace": {
        "config": {
          "label": "Pace",
          "options": [
            "slow",
            "medium",
            "fast"
          ]
        },
        "type": "Select"
      },
      "character_or_plot_driven": {
        "config": {
          "label": "Character- or plot-driven?",
          "options": [
            "Character",
            "Plot",
            "A mix"
          ]
        },
        "type": "Select"
      },
      "strong_character_development": {
        "config": {
          "label": "Strong character development?",
          "options": [
            "Yes",
            "No",
            "It's complicated"
          ]
        },
        "type": "Select"
      },
      "loveable_characters": {
        "config": {
          "label": "Loveable characters?",
          "options": [
            "Yes",
            "No",
            "It's complicated"
          ]
        },
        "type": "Select"
      },
      "diverse_characters": {
        "config": {
          "label": "Diverse characters?",
          "options": [
            "Yes",
            "No",
            "It's complicated"
          ]
        },
        "type": "Select"
      },
      "flawed_characters": {
        "config": {
          "label": "Flawed characters?",
          "options": [
            "Yes",
            "No",
            "It's complicated"
          ]
        },
        "type": "Select"
      },
      "content_warnings": {
        "config": {
          "label": "Content warnings",
          "placeholder": "As exported, comma-separated"
        },
        "type": "Text"
      },
      "content_warning_description": {
        "config": {
          "label": "Content warning description"
        },
        "type": "Text"
      },
      "source": {
        "config": {
          "default_value": "manual",
          "label": "Source",
          "options": [
            "storygraph",
            "goodreads",
            "manual"
          ]
        },
        "type": "Select"
      }
    }
  },
  "label": "Book",
  "repeatable": true,
  "status": true
}