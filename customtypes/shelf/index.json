{
  "format": "custom",
  "id": "shelf",
  "label": "Shelf",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "layout_hint": {
        "type": "Select",
        "config": {
          "label": "Layout hint",
          "options": [
            "dense",
            "airy",
            "spotlight"
          ],
          "default_value": "airy"
        }
      },
      "books": {
        "type": "Group",
        "config": {
          "label": "Books (in display order)",
          "fields": {
            "book": {
              "type": "Link",
              "config": {
                "label": "Book",
                "select": "document",
                "customtypes": [
                  "book"
                ]
              }
            }
          }
        }
      }
    }
  }
}
