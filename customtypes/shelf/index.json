{
  "format": "page",
  "id": "shelf",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Title"
        },
        "type": "Text"
      },
      "description": {
        "config": {
          "label": "Description",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        },
        "type": "StructuredText"
      },
      "layout_hint": {
        "config": {
          "default_value": "airy",
          "label": "Layout hint",
          "options": [
            "dense",
            "airy",
            "spotlight"
          ]
        },
        "type": "Select"
      },
      "books": {
        "config": {
          "fields": {
            "book": {
              "config": {
                "customtypes": [
                  "book"
                ],
                "label": "Book",
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Books (in display order)"
        },
        "type": "Group"
      },
      "slices": {
        "config": {
          "choices": {
            "text_block": {
              "type": "SharedSlice"
            },
            "pull_quote": {
              "type": "SharedSlice"
            },
            "book_spotlight": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    }
  },
  "label": "Shelf",
  "repeatable": true,
  "status": true
}