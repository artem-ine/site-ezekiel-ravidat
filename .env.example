# Required for reading content once the Prismic repository API access is private.
# Create/inspect via `npx prismic token create` or Prismic Settings -> API & Security.
# Keep server-side only (also set in Vercel environment variables); never expose to the browser.
PRISMIC_ACCESS_TOKEN=

# Required only for running local import scripts (`npm run import`, `npm run add-book`).
# Create via `npx prismic token create --write`. Never deploy to Vercel or expose publicly.
PRISMIC_WRITE_TOKEN=

# Optional: if set, POST /api/revalidate requires a matching `secret` in the webhook payload.
# Use the same value as the webhook's secret in Prismic.
PRISMIC_WEBHOOK_SECRET=

# Optional: API key for Google Books fallback during book metadata/cover enrichment.
GOOGLE_BOOKS_API_KEY=
