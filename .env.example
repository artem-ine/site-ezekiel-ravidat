# Optional: only needed if the repository API access is set to private.
# Create one with `npx prismic token create` (server-side only, never expose to the browser).
PRISMIC_ACCESS_TOKEN=

# Optional: if set, POST /api/revalidate requires a matching `secret` in the webhook payload.
# Use the same value as the webhook's secret in Prismic.
PRISMIC_WEBHOOK_SECRET=
